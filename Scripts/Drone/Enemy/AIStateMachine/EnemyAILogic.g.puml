@startuml EnemyAILogic
state "EnemyAILogic State" as RescueDrone_EnemyAILogic_State {
  state "Disabled" as RescueDrone_EnemyAILogic_State_Disabled
  state "Enabled" as RescueDrone_EnemyAILogic_State_Enabled {
    state "Chase" as RescueDrone_EnemyAILogic_State_Chase {
      state "Pursuit" as RescueDrone_EnemyAILogic_State_Pursuit
      state "Retreat" as RescueDrone_EnemyAILogic_State_Retreat
      state "Stay" as RescueDrone_EnemyAILogic_State_Stay
    }
    state "Idle" as RescueDrone_EnemyAILogic_State_Idle
    state "Patrol" as RescueDrone_EnemyAILogic_State_Patrol {
      state "MovingToCircuit" as RescueDrone_EnemyAILogic_State_MovingToCircuit
      state "Scanning" as RescueDrone_EnemyAILogic_State_Scanning
      state "ToPatrolWaypoint" as RescueDrone_EnemyAILogic_State_ToPatrolWaypoint
    }
    state "Search" as RescueDrone_EnemyAILogic_State_Search {
      state "AlertScanning" as RescueDrone_EnemyAILogic_State_AlertScanning
      state "Fetch" as RescueDrone_EnemyAILogic_State_Fetch
    }
  }
}

RescueDrone_EnemyAILogic_State_Chase --> RescueDrone_EnemyAILogic_State_Chase : PhysicsTick
RescueDrone_EnemyAILogic_State_Chase --> RescueDrone_EnemyAILogic_State_Fetch : PlayerLost
RescueDrone_EnemyAILogic_State_Disabled --> RescueDrone_EnemyAILogic_State_Idle : Enable
RescueDrone_EnemyAILogic_State_Enabled --> RescueDrone_EnemyAILogic_State_Enabled : PhysicsTick
RescueDrone_EnemyAILogic_State_Fetch --> RescueDrone_EnemyAILogic_State_Idle : ReturnToIdle
RescueDrone_EnemyAILogic_State_Idle --> RescueDrone_EnemyAILogic_State_Idle : PhysicsTick
RescueDrone_EnemyAILogic_State_Idle --> RescueDrone_EnemyAILogic_State_MovingToCircuit : PhysicsTick
RescueDrone_EnemyAILogic_State_MovingToCircuit --> RescueDrone_EnemyAILogic_State_Idle : ReturnToIdle
RescueDrone_EnemyAILogic_State_MovingToCircuit --> RescueDrone_EnemyAILogic_State_ToPatrolWaypoint : MoveToWaypoint
RescueDrone_EnemyAILogic_State_Patrol --> RescueDrone_EnemyAILogic_State_Patrol : PhysicsTick
RescueDrone_EnemyAILogic_State_Pursuit --> RescueDrone_EnemyAILogic_State_Pursuit : Moved
RescueDrone_EnemyAILogic_State_Pursuit --> RescueDrone_EnemyAILogic_State_Retreat : PlayerDroneTooClose
RescueDrone_EnemyAILogic_State_Pursuit --> RescueDrone_EnemyAILogic_State_Stay : Moved
RescueDrone_EnemyAILogic_State_Pursuit --> RescueDrone_EnemyAILogic_State_Stay : PlayerDroneCloseEnough
RescueDrone_EnemyAILogic_State_Retreat --> RescueDrone_EnemyAILogic_State_Pursuit : PlayerDroneTooFar
RescueDrone_EnemyAILogic_State_Retreat --> RescueDrone_EnemyAILogic_State_Stay : PlayerDroneCloseEnough
RescueDrone_EnemyAILogic_State_Scanning --> RescueDrone_EnemyAILogic_State_ToPatrolWaypoint : ScanningComplete
RescueDrone_EnemyAILogic_State_Search --> RescueDrone_EnemyAILogic_State_Pursuit : PlayerDetected
RescueDrone_EnemyAILogic_State_Search --> RescueDrone_EnemyAILogic_State_Search : PhysicsTick
RescueDrone_EnemyAILogic_State_Stay --> RescueDrone_EnemyAILogic_State_Pursuit : PlayerDroneTooFar
RescueDrone_EnemyAILogic_State_Stay --> RescueDrone_EnemyAILogic_State_Retreat : PlayerDroneTooClose
RescueDrone_EnemyAILogic_State_ToPatrolWaypoint --> RescueDrone_EnemyAILogic_State_Scanning : StartScanning

RescueDrone_EnemyAILogic_State_Enabled : ComputeMovementAlongPath() → VelocityComputed
RescueDrone_EnemyAILogic_State_Enabled : OnMovingAlongPath() → VelocityComputed
RescueDrone_EnemyAILogic_State_Enabled : SmoothlyRotate() → RotationComputed
RescueDrone_EnemyAILogic_State_Pursuit : OnMoved → VelocityComputed
RescueDrone_EnemyAILogic_State_Stay : OnEnter → VelocityComputed

[*] --> RescueDrone_EnemyAILogic_State_Disabled
@enduml
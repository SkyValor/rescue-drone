@startuml PlayerCameraLogic
state "PlayerCameraLogic State" as RescueDrone_PlayerCameraLogic_State {
  state "Disabled" as RescueDrone_PlayerCameraLogic_State_Disabled
  state "Enabled" as RescueDrone_PlayerCameraLogic_State_Enabled
}

RescueDrone_PlayerCameraLogic_State_Disabled --> RescueDrone_PlayerCameraLogic_State_Enabled : Enable
RescueDrone_PlayerCameraLogic_State_Enabled --> RescueDrone_PlayerCameraLogic_State_Disabled : Disable
RescueDrone_PlayerCameraLogic_State_Enabled --> RescueDrone_PlayerCameraLogic_State_Enabled : OnCameraRotationInput
RescueDrone_PlayerCameraLogic_State_Enabled --> RescueDrone_PlayerCameraLogic_State_Enabled : OnCameraZoomInput

RescueDrone_PlayerCameraLogic_State_Enabled : OnZoomIn() → ZoomComputed
RescueDrone_PlayerCameraLogic_State_Enabled : OnZoomOut() → ZoomComputed

[*] --> RescueDrone_PlayerCameraLogic_State_Disabled
@enduml